   "outputs": [],
   "source": [
    "import gsw\n",
    "gliderDF['pressure'] = gsw.p_from_z(-gliderDF.reset_index()['depth'].values, gliderDF['latitude'].values)\n",
    "gliderDF['SA'] = gsw.SA_from_SP(gliderDF.salinity, gliderDF.pressure, gliderDF.longitude, gliderDF.latitude)\n",
    "gliderDF['CT'] = gsw.CT_from_t(gliderDF['SA'], gliderDF['temperature'], gliderDF['pressure'])\n",
    "gliderDF['linear_time'] = mod_argo.datetime2linear(gliderDF['datetime'], ref_time = '2014-01-01')\n",
    "gliderDF['sigma0'] = gsw.sigma0(gliderDF['SA'], gliderDF['CT'])\n",
    "# gliderDF = gliderDF.rename(columns={'doxy': 'oxygen'})\n"
   ]
  },
